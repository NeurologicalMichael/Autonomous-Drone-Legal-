
(rules PCB Drone Practice.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 500.0 (type "board_edge"))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (via_rule
    default "Via[0-3]_600:300_um"
  )
  (via_rule
    default "Via[0-3]_600:300_um"
  )
  (class default
    GND +3.3V +3V3 "/GPS_TX" "/GPS_RX" "Net-(U1-VCAP_2)" "/5V_INPUT" "Net-(U1-PH0)"
    "Net-(U1-PH1)" /[MOTOR1] /[MOTOR2] /[MOTOR3] /[MOTOR4] /NSRT "Net-(U1-PA5)" "Net-(U1-PA7)"
    "Net-(U1-PA6)" "Net-(U1-PA4)" "Net-(U1-PC4)" "unconnected-(U2-RESV-Pad7)" "unconnected-(U2-FSYNC-Pad8)" "Net-(U2-REGOUT)" "unconnected-(U1-PC13-Pad2)" "unconnected-(U1-PC14-Pad3)"
    "unconnected-(U1-PC15-Pad4)" "/[VBAT_SENSE]" "unconnected-(U1-PC1-Pad9)" "unconnected-(U1-PC2-Pad10)" "unconnected-(U1-PC3-Pad11)" "unconnected-(U1-PA0-Pad14)" "unconnected-(U1-PA1-Pad15)" "unconnected-(U1-PA2-Pad16)"
    "unconnected-(U1-PA3-Pad17)" "unconnected-(U1-PC5-Pad25)" "unconnected-(U1-PB2-Pad28)" "unconnected-(U1-PB10-Pad29)" "unconnected-(U1-PB11-Pad30)" "Net-(U1-VCAP_1)" "unconnected-(U1-PB12-Pad33)" "unconnected-(U1-PB13-Pad34)"
    "unconnected-(U1-PB14-Pad35)" "unconnected-(U1-PB15-Pad36)" "unconnected-(U1-PC6-Pad37)" "unconnected-(U1-PC7-Pad38)" "unconnected-(U1-PC8-Pad39)" "unconnected-(U1-PC9-Pad40)" "unconnected-(U1-PA8-Pad41)" "unconnected-(U1-PA9-Pad42)"
    "unconnected-(U1-PA10-Pad43)" "Net-(J7-D-)" "Net-(J7-D+)" "Net-(J1-SWDIO{slash}TMS)" "Net-(J1-SWCLK{slash}TCK)" "unconnected-(U1-PA15-Pad50)" "unconnected-(U1-PC10-Pad51)" "unconnected-(U1-PC11-Pad52)"
    "unconnected-(U1-PC12-Pad53)" "unconnected-(U1-PD2-Pad54)" "unconnected-(U1-PB3-Pad55)" "unconnected-(U1-PB6-Pad58)" "unconnected-(U1-PB7-Pad59)" "Net-(U1-BOOT0)" "Net-(U1-PB8)" "unconnected-(U1-PB9-Pad62)"
    "unconnected-(J1-SWO{slash}TDO-Pad6)" "unconnected-(J1-KEY-Pad7)" "unconnected-(J1-NC{slash}TDI-Pad8)" "/BAT_RAW" +5V "unconnected-(J7-ID-Pad4)" "Net-(D1-A)"
    (clearance_class default)
